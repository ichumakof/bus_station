# Backend
# ASP.NET Core reads double underscore as nested configuration
ConnectionStrings__DefaultConnection=Server=localhost;Database=BusStationDb;Integrated Security=True;TrustServerCertificate=True;

# JWT
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Jwt__Issuer=BusStationApi
Jwt__Audience=BusStationClient

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5051
